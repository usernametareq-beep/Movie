<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results - Movie House</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --bg-color: #090d16; --card-bg: #131b2e; --card-border: rgba(255, 255, 255, 0.08); --text-color: #f1f5f9; --text-muted: #94a3b8; --accent-gradient: linear-gradient(135deg, #10b981 0%, #06b6d4 100%); }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: var(--bg-color); color: var(--text-color); font-family: 'Plus Jakarta Sans', sans-serif; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }
        .container { max-width: 1240px; width: 100%; padding: 24px 20px; flex: 1; }
        header { width: 100%; padding: 16px 24px; background: #131b2e; text-align: center; }
        .logo-text-main { font-size: 24px; font-weight: 800; color: #fff; text-decoration: none; }
        .logo-text-main span { background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .search-container { width: 100%; max-width: 500px; margin: 20px auto; }
        .search-form { display: flex; gap: 8px; background: var(--card-bg); padding: 6px; border-radius: 30px; border: 1px solid var(--card-border); }
        .search-input { flex: 1; background: transparent; border: none; padding: 10px 18px; color: #fff; outline: none; }
        .search-btn { background: var(--accent-gradient); color: #fff; border: none; padding: 10px 22px; border-radius: 25px; cursor: pointer; font-weight: 700; }
        .section-title { font-size: 16px; font-weight: 800; margin: 20px 0; text-align: center; }
        .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; }
        @media (max-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 600px) { .grid { grid-template-columns: repeat(2, 1fr); } }
        .movie-card { background: var(--card-bg); border-radius: 14px; overflow: hidden; border: 1px solid var(--card-border); text-decoration: none; display: flex; flex-direction: column; }
        .poster-box { height: 240px; width: 100%; background: #000; }
        .poster-box img { width: 100%; height: 100%; object-fit: cover; }
        .card-details { padding: 12px; text-align: center; }
        .movie-title { font-size: 13px; font-weight: 700; color: #fff; }
        .back-btn { display: inline-block; margin-bottom: 20px; color: #10b981; text-decoration: none; font-weight: 700; }
    </style>
</head>
<body>
    <header>
        <a href="/" class="logo-text-main">MOVIE<span>HOUSE</span></a>
    </header>

    <div class="container">
        <a href="/" class="back-btn">← Back to Home</a>

        <div class="search-container">
            <form action="/search" method="GET" class="search-form">
                <input type="text" name="q" class="search-input" placeholder="Search movies..." value="<%= searchQuery %>" required>
                <button type="submit" class="search-btn">Search</button>
            </form>
        </div>

        <h3 class="section-title">SEARCH RESULTS FOR: "<%= searchQuery %>"</h3>

        <% if (movies.length > 0) { %>
            <div class="grid">
                <% movies.forEach(movie => { %>
                    <a href="/movie/<%= movie.id %>" class="movie-card">
                        <div class="poster-box">
                            <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                        </div>
                        <div class="card-details">
                            <h4 class="movie-title"><%= movie.title %></h4>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } else { %>
            <p style="text-align: center; color: var(--text-muted); margin-top: 40px;">No movies found matching your query.</p>
        <% } %>
    </div>
</body>
</html>