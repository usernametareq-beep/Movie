<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Login</title>
    <style>
        body { background: #090d16; color: #fff; font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-box { background: #131b2e; padding: 30px; border-radius: 12px; text-align: center; width: 300px; border: 1px solid rgba(255,255,255,0.1); }
        input { width: 100%; padding: 10px; margin: 15px 0; border-radius: 6px; border: 1px solid #333; background: #090d16; color: #fff; box-sizing: border-box; }
        button { background: #10b981; border: none; color: #fff; padding: 10px; width: 100%; border-radius: 6px; cursor: pointer; font-weight: bold; }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>Admin Login</h2>
        <% if (error) { %><p style="color: red;"><%= error %></p><% } %>
        <form action="/admin/login" method="POST">
            <input type="password" name="password" placeholder="Enter Admin Password" required>
            <button type="submit">Login</button>
        </form>
    </div>
</body>
</html>
