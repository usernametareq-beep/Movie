<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= movie.title %> - MovieHouse</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-900 text-white p-6">

  <div class="max-w-4xl mx-auto space-y-6">
    <a href="/" class="text-red-500 text-sm font-semibold hover:underline">&larr; Back to Home</a>

    <div class="bg-gray-800 rounded-lg p-6 space-y-6">
      <div class="flex flex-col md:flex-row gap-6">
        <img src="<%= movie.poster || '/placeholder.jpg' %>" alt="<%= movie.title %>" class="w-48 h-72 rounded object-cover">
        <div class="space-y-2">
          <h1 class="text-3xl font-bold"><%= movie.title %></h1>
          <p class="text-sm text-gray-400">Category: <span class="text-white"><%= movie.category %></span></p>
          <p class="text-sm text-gray-400">Type: <span class="text-white capitalize"><%= movie.contentType %></span></p>
          <p class="text-sm text-gray-400">Total Views: <span class="text-white"><%= movie.views %></span></p>
        </div>
      </div>

      <!-- Player / Streaming Links -->
      <div class="border-t border-gray-700 pt-6">
        <h3 class="text-xl font-bold mb-4">Watch Now:</h3>
        
        <% if (movie.contentType === 'movie') { %>
          <div class="flex flex-wrap gap-3">
            <% if (movie.videoLinks && movie.videoLinks.length) { %>
              <% movie.videoLinks.forEach(link => { %>
                <a href="<%= link.url %>" target="_blank" class="bg-red-600 hover:bg-red-700 px-5 py-2 rounded text-sm font-bold transition">
                  ▶ <%= link.name %>
                </a>
              <% }) %>
            <% } else { %>
              <p class="text-gray-500 text-sm">No stream links added yet.</p>
            <% } %>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <% if (movie.episodes && movie.episodes.length) { %>
              <% movie.episodes.forEach(ep => { %>
                <a href="<%= ep.url %>" target="_blank" class="bg-gray-700 hover:bg-gray-600 p-3 rounded flex justify-between items-center transition">
                  <span class="font-semibold text-sm">S<%= ep.season %> E<%= ep.episodeNumber %> - <%= ep.name %></span>
                  <span class="text-red-400 text-xs">Watch &rarr;</span>
                </a>
              <% }) %>
            <% } else { %>
              <p class="text-gray-500 text-sm">No episodes available.</p>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Related Movies -->
    <% if (relatedMovies && relatedMovies.length) { %>
      <div>
        <h3 class="text-xl font-bold mb-4">You Might Also Like</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
          <% relatedMovies.forEach(rel => { %>
            <a href="/movie/<%= rel._id %>" class="bg-gray-800 rounded overflow-hidden block">
              <img src="<%= rel.poster || '/placeholder.jpg' %>" class="w-full h-36 object-cover">
              <p class="p-2 text-xs font-bold truncate"><%= rel.title %></p>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

</body>
</html>
