<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - Bangla Movie House</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #141414;
            color: #fff;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        .video-player-box {
            background-color: #000;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }
        video {
            width: 100%;
            display: block;
            max-height: 500px;
        }
        .player-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            background-color: #1f1f1f;
            padding: 12px;
        }
        .control-btn {
            background-color: #e50914;
            color: white;
            border: none;
            padding: 8px 16px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .control-btn:hover {
            background-color: #b80710;
        }
        .movie-details {
            margin-top: 20px;
            background-color: #1f1f1f;
            padding: 20px;
            border-radius: 8px;
        }
        .server-buttons {
            margin-top: 15px;
        }
        .server-btn {
            display: inline-block;
            background-color: #333;
            color: #fff;
            padding: 8px 12px;
            margin-right: 8px;
            margin-bottom: 8px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 14px;
        }
        .server-btn:hover {
            background-color: #555;
        }
        .related-section {
            margin-top: 30px;
        }
        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        .related-card {
            background-color: #1f1f1f;
            border-radius: 6px;
            overflow: hidden;
            text-decoration: none;
            color: white;
        }
        .related-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .related-card p {
            padding: 8px;
            margin: 0;
            font-size: 13px;
            text-align: center;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 15px;
            color: #aaa;
            text-decoration: none;
        }
        .back-link:hover {
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        
        <h2><%= movie.title %></h2>

        <!-- Video Player Section -->
        <div class="video-player-box">
            <video id="mainVideo" controls poster="<%= movie.poster %>">
                <% if (movie.videoLinks && movie.videoLinks.length > 0) { %>
                    <source src="<%= movie.videoLinks[0].url %>" type="video/mp4">
                <% } %>
                Your browser does not support the video element.
            </video>

            <!-- Custom 5 Sec Skip Controls -->
            <div class="player-controls">
                <button class="control-btn" onclick="rewind(5)">⏪ 5 Sec</button>
                <button class="control-btn" onclick="forward(5)">5 Sec ⏩</button>
            </div>
        </div>

        <!-- Movie Information -->
        <div class="movie-details">
            <p><strong>Category:</strong> <%= movie.category %></p>
            <p><strong>Views:</strong> <%= movie.views %></p>

            <!-- Multiple Server Links -->
            <% if (movie.videoLinks && movie.videoLinks.length > 1) { %>
                <div class="server-buttons">
                    <strong>Select Server:</strong><br><br>
                    <% movie.videoLinks.forEach((link, index) => { %>
                        <button class="server-btn" onclick="changeServer('<%= link.url %>')">
                            <%= link.name || 'Server ' + (index + 1) %>
                        </button>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Related Movies -->
        <% if (typeof relatedMovies !== 'undefined' && relatedMovies.length > 0) { %>
            <div class="related-section">
                <h3>Related Movies</h3>
                <div class="related-grid">
                    <% relatedMovies.forEach(rel => { %>
                        <a href="/movie/<%= rel._id %>" class="related-card">
                            <img src="<%= rel.poster %>" alt="<%= rel.title %>">
                            <p><%= rel.title %></p>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    <!-- JavaScript logic for 5-sec Forward/Backward & Shortcuts -->
    <script>
        const video = document.getElementById('mainVideo');

        // Rewind function
        function rewind(seconds) {
            if (video) {
                video.currentTime = Math.max(0, video.currentTime - seconds);
            }
        }

        // Forward function
        function forward(seconds) {
            if (video) {
                video.currentTime = Math.min(video.duration || 0, video.currentTime + seconds);
            }
        }

        // Change video server dynamically
        function changeServer(url) {
            if (video) {
                video.src = url;
                video.play();
            }
        }

        // Keyboard Shortcuts (Left / Right Arrow)
        document.addEventListener('keydown', function(event) {
            // Check if active element is not an input field
            if (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
                if (event.key === 'ArrowLeft') {
                    event.preventDefault();
                    rewind(5);
                } else if (event.key === 'ArrowRight') {
                    event.preventDefault();
                    forward(5);
                }
            }
        });
    </script>
</body>
</html>
