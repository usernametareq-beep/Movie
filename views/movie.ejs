<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - Movie House</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #141414;
            color: #ffffff;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 15px;
            color: #aaa;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.2s;
        }
        .back-link:hover, .back-link:focus {
            color: #fff;
            outline: 2px solid #e50914;
        }
        .movie-title {
            margin-bottom: 15px;
            font-size: 24px;
        }
        .video-player-box {
            background-color: #000;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
            position: relative;
            min-height: 450px;
        }
        video, iframe {
            width: 100%;
            height: 450px;
            display: block;
            border: none;
        }
        .player-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            background-color: #1f1f1f;
            padding: 12px;
        }
        .control-btn {
            background-color: #e50914;
            color: #fff;
            border: none;
            padding: 8px 16px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .control-btn:hover, .control-btn:focus {
            background-color: #b80710;
            outline: 2px solid #ffffff;
        }
        .movie-details {
            margin-top: 20px;
            background-color: #1f1f1f;
            padding: 20px;
            border-radius: 8px;
        }
        .movie-details p {
            margin-bottom: 10px;
            font-size: 15px;
        }
        .server-buttons {
            margin-top: 15px;
        }
        .server-btn {
            display: inline-block;
            background-color: #333;
            color: #fff;
            padding: 8px 14px;
            margin-right: 8px;
            margin-bottom: 8px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.2s;
        }
        .server-btn:hover, .server-btn:focus {
            background-color: #555;
            outline: 2px solid #e50914;
        }
        .server-btn.active {
            background-color: #e50914;
        }
        .related-section {
            margin-top: 30px;
        }
        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        .related-card {
            background-color: #1f1f1f;
            border-radius: 6px;
            overflow: hidden;
            text-decoration: none;
            color: white;
            transition: transform 0.2s;
        }
        .related-card:hover, .related-card:focus {
            transform: scale(1.03);
            outline: 2px solid #e50914;
        }
        .related-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .related-card p {
            padding: 8px;
            margin: 0;
            font-size: 13px;
            text-align: center;
        }
        .terabox-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 450px;
            padding: 20px;
            text-align: center;
            background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
        }
        .terabox-btn {
            background-color: #e50914;
            color: #ffffff;
            padding: 14px 28px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            font-size: 16px;
            box-shadow: 0 4px 15px rgba(229,9,20,0.4);
            transition: transform 0.2s, background-color 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .terabox-btn:hover {
            background-color: #b80710;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <div class="container">
        <a href="/" class="back-link" tabindex="0">← Back to Home</a>
        
        <h2 class="movie-title"><%= movie.title %></h2>

        <% 
            function formatDriveUrl(url) {
                if (!url || typeof url !== 'string') return url;
                if (url.includes('drive.google.com')) {
                    return url.replace(/\/view(\?.*)?$/, '/preview')
                              .replace(/\/edit(\?.*)?$/, '/preview')
                              .replace(/\/usp=sharing$/, '');
                }
                return url;
            }

            function getYouTubeEmbedUrl(url) {
                if (!url || typeof url !== 'string') return null;
                let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
                let match = url.match(regExp);
                return (match && match[2].length === 11) ? 'https://www.youtube.com/embed/' + match[2] : null;
            }

            function isTeraboxLink(url) {
                if (!url || typeof url !== 'string') return false;
                return /terabox|neobox|teraboxapp|1024tera|freeterabox/i.test(url);
            }

            function isGenericEmbed(url) {
                if (!url || typeof url !== 'string') return false;
                return url.includes('/e/') || url.includes('/embed/') || url.includes('tpead.net') || url.includes('drive.google.com');
            }
            
            // Initial URL extraction
            let initialUrl = '';
            if (movie.episodes && movie.episodes.length > 0) {
                let firstEp = movie.episodes[0];
                initialUrl = typeof firstEp === 'string' ? firstEp : (firstEp.url || firstEp.videoUrl || firstEp.embedUrl || firstEp.link || (firstEp.videoLinks && firstEp.videoLinks[0] ? firstEp.videoLinks[0].url : ''));
            } else if (movie.videoLinks && movie.videoLinks.length > 0) {
                initialUrl = movie.videoLinks[0].url;
            } else if (movie.videoUrl) {
                initialUrl = movie.videoUrl;
            }

            initialUrl = formatDriveUrl(initialUrl);
            let initialIsTerabox = isTeraboxLink(initialUrl);
            let initialYouTubeEmbed = getYouTubeEmbedUrl(initialUrl);
            let initialIsEmbed = isGenericEmbed(initialUrl);
            let defaultPoster = 'https://via.placeholder.com/300x400?text=No+Poster';
        %>

        <div class="video-player-box">
            <div id="mediaArea">
                <% if (initialIsTerabox) { %>
                    <div class="terabox-container">
                        <p style="font-size: 20px; font-weight: 600; margin-bottom: 15px; color: #fff;">TeraBox Server Selected</p>
                        <a href="<%= initialUrl %>" target="_blank" rel="noopener noreferrer" class="terabox-btn">
                            ▶ Click Here to Watch / Download
                        </a>
                        <span style="font-size: 13px; color: #9ca3af; margin-top: 12px;">Play directly on TeraBox server without error</span>
                    </div>
                <% } else if (initialYouTubeEmbed) { %>
                    <iframe id="ytPlayer" src="<%= initialYouTubeEmbed %>" allowfullscreen allow="autoplay"></iframe>
                <% } else if (initialIsEmbed) { %>
                    <iframe id="embedPlayer" src="<%= initialUrl %>" allowfullscreen allow="autoplay" scrolling="no"></iframe>
                <% } else { %>
                    <video id="mainVideo" controls poster="<%= movie.poster || defaultPoster %>">
                        <source src="<%= initialUrl %>" type="video/mp4">
                        Your browser does not support the video element.
                    </video>
                <% } %>
            </div>

            <div class="player-controls" id="controlsBox" style="<%= (initialIsTerabox || initialYouTubeEmbed || initialIsEmbed) ? 'display: none;' : '' %>">
                <button class="control-btn" tabindex="0" onclick="rewind(5)">⏪ 5 Sec</button>
                <button class="control-btn" tabindex="0" onclick="forward(5)">5 Sec ⏩</button>
            </div>
        </div>

        <div class="movie-details">
            <p><strong>Category:</strong> <%= movie.category %></p>
            <p><strong>Views:</strong> <%= movie.views %></p>

            <% if (movie.episodes && movie.episodes.length > 0) { %>
                <div class="server-buttons" id="seasonsContainer" style="display: none;">
                    <strong>Seasons:</strong><br><br>
                    <div id="seasonButtonsBox"></div>
                </div>

                <div class="server-buttons" style="margin-top: 15px;">
                    <strong>Episodes:</strong><br><br>
                    <div id="episodesButtonsBox"></div>
                </div>
            <% } %>

            <% if (movie.videoLinks && movie.videoLinks.length > 1) { %>
                <div class="server-buttons">
                    <strong>Select Server:</strong><br><br>
                    <% movie.videoLinks.forEach((link, index) => { %>
                        <button class="server-btn" tabindex="0" onclick="switchVideoServer('<%= link.url %>')">
                            <%= link.name || 'Server ' + (index + 1) %>
                        </button>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <% if (typeof relatedMovies !== 'undefined' && relatedMovies.length > 0) { %>
            <div class="related-section">
                <h3>Related Content</h3>
                <div class="related-grid">
                    <% relatedMovies.forEach(rel => { %>
                        <a href="/movie/<%= rel._id %>" class="related-card" tabindex="0">
                            <img 
                                src="<%= rel.poster %>" 
                                alt="<%= rel.title %>" 
                                onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400?text=No+Image';"
                            >
                            <p><%= rel.title %></p>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    <script>
        const movieData = <%- JSON.stringify(movie) %>;

        function processDriveUrl(url) {
            if (!url || typeof url !== 'string') return url;
            if (url.includes('drive.google.com')) {
                return url.replace(/\/view(\?.*)?$/, '/preview')
                          .replace(/\/edit(\?.*)?$/, '/preview')
                          .replace(/\/usp=sharing$/, '');
            }
            return url;
        }

        function parseYouTubeUrl(url) {
            if (!url || typeof url !== 'string') return null;
            let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            let match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }

        function switchVideoServer(url) {
            if (!url) return;
            url = processDriveUrl(url);

            const mediaArea = document.getElementById('mediaArea');
            const controlsBox = document.getElementById('controlsBox');
            
            // TeraBox লিঙ্ক চেক
            const isTeraBox = /terabox|neobox|teraboxapp|1024tera|freeterabox/i.test(url);
            const ytId = parseYouTubeUrl(url);
            const isEmbedLink = url.includes('/e/') || url.includes('/embed/') || url.includes('tpead.net') || url.includes('drive.google.com');

            if (isTeraBox) {
                mediaArea.innerHTML = `
                    <div class="terabox-container">
                        <p style="font-size: 20px; font-weight: 600; margin-bottom: 15px; color: #fff;">TeraBox Server Selected</p>
                        <a href="${url}" target="_blank" rel="noopener noreferrer" class="terabox-btn">
                            ▶ Click Here to Watch / Download
                        </a>
                        <span style="font-size: 13px; color: #9ca3af; margin-top: 12px;">Play directly on TeraBox server without error</span>
                    </div>
                `;
                if (controlsBox) controlsBox.style.display = 'none';
            } else if (ytId) {
                mediaArea.innerHTML = `<iframe id="ytPlayer" src="https://www.youtube.com/embed/${ytId}?autoplay=1" allowfullscreen allow="autoplay"></iframe>`;
                if (controlsBox) controlsBox.style.display = 'none';
            } else if (isEmbedLink) {
                mediaArea.innerHTML = `<iframe id="embedPlayer" src="${url}" allowfullscreen allow="autoplay" scrolling="no"></iframe>`;
                if (controlsBox) controlsBox.style.display = 'none';
            } else {
                mediaArea.innerHTML = `
                    <video id="mainVideo" controls autoplay poster="<%= movie.poster || 'https://via.placeholder.com/300x400?text=No+Poster' %>">
                        <source src="${url}" type="video/mp4">
                        Your browser does not support the video element.
                    </video>
                `;
                if (controlsBox) controlsBox.style.display = 'flex';
            }
        }

        // Process Seasons & Episodes dynamically from admin inputs
        document.addEventListener('DOMContentLoaded', () => {
            const episodes = movieData.episodes || [];
            if (episodes.length === 0) return;

            // Group episodes by season number
            const seasonsMap = {};
            episodes.forEach((ep, index) => {
                let sNum = ep.season || ep.seasonNumber || ep.seasonNo || ep.s || 1;
                if (!seasonsMap[sNum]) {
                    seasonsMap[sNum] = [];
                }
                seasonsMap[sNum].push({ ...ep, defaultIndex: index + 1 });
            });

            const seasonKeys = Object.keys(seasonsMap).sort((a, b) => Number(a) - Number(b));
            const seasonsContainer = document.getElementById('seasonsContainer');
            const seasonButtonsBox = document.getElementById('seasonButtonsBox');
            const episodesButtonsBox = document.getElementById('episodesButtonsBox');

            function renderEpisodes(seasonKey) {
                episodesButtonsBox.innerHTML = '';
                const seasonEps = seasonsMap[seasonKey];

                seasonEps.forEach((ep, idx) => {
                    let epUrl = typeof ep === 'string' ? ep : (ep.url || ep.videoUrl || ep.embedUrl || ep.link || (ep.videoLinks && ep.videoLinks[0] ? ep.videoLinks[0].url : ''));
                    let epNum = ep.episode || ep.episodeNumber || ep.epNo || ep.defaultIndex;
                    let epTitle = ep.title ? ep.title : ('Episode ' + epNum);

                    const btn = document.createElement('button');
                    btn.className = 'server-btn';
                    btn.setAttribute('tabindex', '0');
                    btn.innerText = epTitle;
                    btn.onclick = () => switchVideoServer(epUrl);
                    episodesButtonsBox.appendChild(btn);
                });
            }

            // Show Seasons if there is more than 1 season
            if (seasonKeys.length > 1) {
                seasonsContainer.style.display = 'block';
                seasonButtonsBox.innerHTML = '';

                seasonKeys.forEach((sKey, idx) => {
                    const btn = document.createElement('button');
                    btn.className = 'server-btn season-btn' + (idx === 0 ? ' active' : '');
                    btn.setAttribute('tabindex', '0');
                    btn.innerText = 'Season ' + sKey;
                    btn.onclick = () => {
                        document.querySelectorAll('.season-btn').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        renderEpisodes(sKey);
                    };
                    seasonButtonsBox.appendChild(btn);
                });
            }

            // Initially render Season 1 episodes
            renderEpisodes(seasonKeys[0]);
        });

        function rewind(seconds = 5) {
            const video = document.getElementById('mainVideo');
            if (video) {
                video.currentTime = Math.max(0, video.currentTime - seconds);
            }
        }

        function forward(seconds = 5) {
            const video = document.getElementById('mainVideo');
            if (video) {
                const maxTime = isNaN(video.duration) ? video.currentTime + seconds : video.duration;
                video.currentTime = Math.min(maxTime, video.currentTime + seconds);
            }
        }

        window.addEventListener('keydown', function (e) {
            const video = document.getElementById('mainVideo');
            if (!video) return;

            const activeTag = document.activeElement.tagName;
            if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') return;

            if (e.key === 'ArrowLeft' || e.keyCode === 37) {
                e.preventDefault();
                rewind(5);
            } else if (e.key === 'ArrowRight' || e.keyCode === 39) {
                e.preventDefault();
                forward(5);
            }
        }, true);
    </script>
</body>
</html>
