<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie House</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { 
            --bg-color: #090d16; 
            --card-bg: #131b2e; 
            --card-border: rgba(255, 255, 255, 0.08); 
            --text-color: #f1f5f9; 
            --text-muted: #94a3b8; 
            --accent-gradient: linear-gradient(135deg, #10b981 0%, #06b6d4 100%); 
        }

        [data-theme="light"] { 
            --bg-color: #f8fafc; 
            --card-bg: #ffffff; 
            --card-border: rgba(0, 0, 0, 0.08); 
            --text-color: #0f172a; 
            --text-muted: #64748b; 
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            background: var(--bg-color); 
            color: var(--text-color); 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            align-items: center;
            transition: background 0.3s, color 0.3s;
        }
        
        .container { max-width: 1240px; width: 100%; padding: 24px 20px; flex: 1; display: flex; flex-direction: column; align-items: center; }
        
        /* HEADER - CENTERED LOGO & RIGHT ALIGNED ICON */
        header { 
            width: 100%; 
            padding: 16px 24px; 
            background: var(--card-bg); 
            border-bottom: 1px solid var(--card-border); 
            position: sticky; 
            top: 0; 
            z-index: 100; 
            display: flex; 
            justify-content: center; 
        }
        .header-content { 
            max-width: 1240px; 
            width: 100%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            position: relative; 
        }
        .logo-text-main { 
            font-size: 24px; 
            font-weight: 800; 
            color: var(--text-color); 
            text-decoration: none; 
        }
        .logo-text-main span { 
            background: var(--accent-gradient); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
        }
        
        .theme-icon-btn { 
            position: absolute; 
            right: 0; 
            background: var(--bg-color); 
            border: 1px solid var(--card-border); 
            color: var(--text-color); 
            width: 40px; 
            height: 40px; 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            cursor: pointer; 
            font-size: 18px; 
            transition: transform 0.2s; 
        }
        .theme-icon-btn:hover { transform: scale(1.08); }

        .search-container { width: 100%; max-width: 500px; margin-bottom: 25px; }
        .search-form { display: flex; gap: 8px; background: var(--card-bg); padding: 6px; border-radius: 30px; border: 1px solid var(--card-border); }
        .search-input { flex: 1; background: transparent; border: none; padding: 10px 18px; color: var(--text-color); outline: none; }
        .search-btn { background: var(--accent-gradient); color: #fff; border: none; padding: 10px 22px; border-radius: 25px; cursor: pointer; font-weight: 700; }
        
        .categories { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; width: 100%; margin-bottom: 30px; }
        .cat-btn { background: var(--card-bg); color: var(--text-muted); padding: 9px 20px; border-radius: 30px; font-size: 13px; font-weight: 600; border: 1px solid var(--card-border); text-decoration: none; }
        .cat-btn.active { background: var(--accent-gradient); color: #fff; border-color: transparent; }
        
        .section-title { font-size: 16px; font-weight: 800; margin: 15px 0 20px 0; text-transform: uppercase; text-align: center; }
        .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; width: 100%; margin-bottom: 25px; }
        @media (max-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 600px) { .grid { grid-template-columns: repeat(2, 1fr); } }
        
        .movie-card { background: var(--card-bg); border-radius: 14px; overflow: hidden; border: 1px solid var(--card-border); display: flex; flex-direction: column; text-decoration: none; color: inherit; }
        .poster-box { position: relative; width: 100%; height: 240px; background: #000; }
        .poster-box img { width: 100%; height: 100%; object-fit: cover; }
        .play-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s; }
        .movie-card:hover .play-overlay { opacity: 1; }
        .play-icon { font-size: 40px; color: #fff; }
        .badge-pinned { position: absolute; top: 8px; left: 8px; background: #f59e0b; color: #000; font-size: 9.5px; font-weight: 800; padding: 3px 8px; border-radius: 16px; }
        .badge-views { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.65); color: #fff; font-size: 10.5px; padding: 3px 8px; border-radius: 16px; }
        
        .card-details { padding: 12px; text-align: center; flex: 1; display: flex; align-items: center; justify-content: center; }
        .movie-title { font-size: 13px; font-weight: 700; color: var(--text-color); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

        .pagination { display: flex; justify-content: center; gap: 8px; margin: 15px 0 35px 0; width: 100%; }
        .page-link { display: inline-flex; justify-content: center; align-items: center; min-width: 38px; height: 38px; padding: 0 10px; background: var(--card-bg); color: var(--text-muted); border: 1px solid var(--card-border); border-radius: 10px; font-size: 13px; text-decoration: none; font-weight: 700; }
        .page-link.active { background: var(--accent-gradient); color: #fff; border-color: transparent; }
        .page-link.disabled { opacity: 0.4; pointer-events: none; }

        footer { width: 100%; margin-top: auto; padding: 25px 20px; background: var(--card-bg); border-top: 1px solid var(--card-border); text-align: center; }
    </style>
</head>
<body>
    <header>
        <div class="header-content">
            <a href="/" class="logo-text-main">MOVIE<span>HOUSE</span></a>
            <button class="theme-icon-btn" id="themeIconBtn" onclick="toggleTheme()" title="Toggle Theme">☀️</button>
        </div>
    </header>

    <div class="container">
        <!-- SEARCH BAR -->
        <div class="search-container">
            <form action="/search" method="GET" class="search-form">
                <input type="text" name="q" class="search-input" placeholder="Search movies..." required>
                <button type="submit" class="search-btn">Search</button>
            </form>
        </div>

        <!-- CATEGORIES -->
        <div class="categories">
            <a href="/" class="cat-btn <%= !selectedCategory ? 'active' : '' %>">All Movies</a>
            <% categories.forEach(cat => { %>
                <a href="/?category=<%= cat %>" class="cat-btn <%= selectedCategory === cat ? 'active' : '' %>"><%= cat %></a>
            <% }) %>
        </div>

        <!-- RECENTLY UPDATED -->
        <h3 class="section-title">RECENTLY UPDATED</h3>
        <% if (recentMovies.length > 0) { %>
            <div class="grid">
                <% recentMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie.id %>" class="movie-card">
                        <div class="poster-box">
                            <% if (movie.isPinned) { %><span class="badge-pinned">📌 PINNED</span><% } %>
                            <span class="badge-views">👁 <%= movie.views || 0 %></span>
                            <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                            <div class="play-overlay"><span class="play-icon">▶</span></div>
                        </div>
                        <div class="card-details">
                            <h4 class="movie-title"><%= movie.title %></h4>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>

        <!-- PAGINATION -->
        <% if (totalPages > 1) { %>
            <% let catQuery = selectedCategory ? `&category=${selectedCategory}` : ''; %>
            <div class="pagination">
                <a href="/?page=<%= currentPage - 1 %><%= catQuery %>" class="page-link <%= currentPage === 1 ? 'disabled' : '' %>">&lt;</a>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="/?page=<%= i %><%= catQuery %>" class="page-link <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
                <% } %>
                <a href="/?page=<%= currentPage + 1 %><%= catQuery %>" class="page-link <%= currentPage === totalPages ? 'disabled' : '' %>">&gt;</a>
            </div>
        <% } %>

        <!-- POPULAR MOVIES -->
        <h3 class="section-title">POPULAR MOVIES</h3>
        <% if (popularMovies.length > 0) { %>
            <div class="grid">
                <% popularMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie.id %>" class="movie-card">
                        <div class="poster-box">
                            <% if (movie.isPinned) { %><span class="badge-pinned">📌 PINNED</span><% } %>
                            <span class="badge-views">👁 <%= movie.views || 0 %></span>
                            <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                            <div class="play-overlay"><span class="play-icon">▶</span></div>
                        </div>
                        <div class="card-details">
                            <h4 class="movie-title"><%= movie.title %></h4>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>
    </div>

    <footer>
        <p style="font-size: 13px; color: var(--text-muted);">&copy; Movie House - All Rights Reserved</p>
    </footer>

    <script>
        function initTheme() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            if (savedTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
                document.getElementById('themeIconBtn').innerText = '🌙';
            } else {
                document.documentElement.removeAttribute('data-theme');
                document.getElementById('themeIconBtn').innerText = '☀️';
            }
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            if (currentTheme === 'light') {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('theme', 'dark');
                document.getElementById('themeIconBtn').innerText = '☀️';
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('theme', 'light');
                document.getElementById('themeIconBtn').innerText = '🌙';
            }
        }

        initTheme();
    </script>
</body>
</html>