<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <title>MovieHouse</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-900 text-white">
  <nav class="p-4 bg-gray-800 flex justify-between">
    <a href="/" class="text-xl font-bold text-red-500">MovieHouse</a>
    <form action="/search" method="GET" class="flex gap-2">
      <input type="text" name="q" placeholder="Search..." class="p-1 px-3 bg-gray-700 rounded">
      <button class="bg-red-600 px-3 py-1 rounded">Search</button>
    </form>
  </nav>

  <div class="p-6 max-w-7xl mx-auto">
    <div class="flex gap-2 mb-6">
      <a href="/" class="px-3 py-1 rounded <%= selectedCategory==='All'?'bg-red-600':'bg-gray-800' %>">All</a>
      <% categories.forEach(cat => { %>
        <a href="/?category=<%= cat %>" class="px-3 py-1 rounded <%= selectedCategory===cat?'bg-red-600':'bg-gray-800' %>"><%= cat %></a>
      <% }) %>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% movies.forEach(movie => { %>
        <a href="/movie/<%= movie._id %>" class="bg-gray-800 rounded overflow-hidden block">
          <img src="<%= movie.poster %>" class="w-full h-64 object-cover">
          <div class="p-2">
            <h3 class="font-bold truncate"><%= movie.title %></h3>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</body>
</html>
