<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie House - Watch Free Movies</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #141414;
            color: #fff;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #000;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #e50914;
            text-decoration: none;
        }
        .search-box form {
            display: flex;
        }
        .search-box input {
            padding: 8px 12px;
            border: none;
            border-radius: 4px 0 0 4px;
            outline: none;
        }
        .search-box button {
            background: #e50914;
            color: #fff;
            border: none;
            padding: 8px 12px;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
        }
        .category-bar {
            background-color: #1f1f1f;
            padding: 10px 30px;
            display: flex;
            gap: 10px;
            overflow-x: auto;
            white-space: nowrap;
        }
        .cat-btn {
            color: #ccc;
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 20px;
            background-color: #2b2b2b;
            font-size: 14px;
            transition: 0.2s;
        }
        .cat-btn:hover, .cat-btn.active {
            background-color: #e50914;
            color: #fff;
        }
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 20px;
        }
        .section-title {
            border-left: 4px solid #e50914;
            padding-left: 10px;
            margin-bottom: 15px;
            font-size: 20px;
        }
        .movie-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .movie-card {
            background-color: #1f1f1f;
            border-radius: 8px;
            overflow: hidden;
            text-decoration: none;
            color: #fff;
            transition: transform 0.2s;
            position: relative;
        }
        .movie-card:hover {
            transform: scale(1.04);
        }
        .movie-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }
        .movie-info {
            padding: 10px;
        }
        .movie-title {
            font-size: 14px;
            font-weight: bold;
            margin: 0 0 5px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .movie-meta {
            font-size: 12px;
            color: #aaa;
        }
        .pin-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0,0,0,0.8);
            color: gold;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <header>
        <a href="/" class="logo">Movie House</a>
        <div class="search-box">
            <form action="/search" method="GET">
                <input type="text" name="q" placeholder="Search movies..." required>
                <button type="submit">Search</button>
            </form>
        </div>
    </header>

    <!-- Categories & Subcategories Filter Bar -->
    <div class="category-bar">
        <a href="/" class="cat-btn <%= (!selectedCategory) ? 'active' : '' %>">All</a>
        
        <% categories.forEach(cat => { %>
            <a href="/?category=<%= encodeURIComponent(cat) %>" 
               class="cat-btn <%= (typeof selectedCategory !== 'undefined' && selectedCategory === cat) ? 'active' : '' %>">
                <%= cat %>
            </a>
        <% }) %>
    </div>

    <div class="container">
        <!-- Pinned Movies Section -->
        <% if (pinnedMovies && pinnedMovies.length > 0 && !selectedCategory) { %>
            <h2 class="section-title">📌 Featured Movies</h2>
            <div class="movie-grid">
                <% pinnedMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie._id %>" class="movie-card">
                        <span class="pin-badge">📌 Pinned</span>
                        <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                        <div class="movie-info">
                            <p class="movie-title"><%= movie.title %></p>
                            <p class="movie-meta"><%= movie.category %></p>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>

        <!-- Latest / Filtered Movies Section -->
        <h2 class="section-title">
            <%= selectedCategory ? selectedCategory + ' Movies' : 'Latest Movies' %>
        </h2>
        
        <div class="movie-grid">
            <% if (latestMovies && latestMovies.length > 0) { %>
                <% latestMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie._id %>" class="movie-card">
                        <img src="<%= movie.poster %>" alt="<%= movie.title %>">
                        <div class="movie-info">
                            <p class="movie-title"><%= movie.title %></p>
                            <p class="movie-meta"><%= movie.category %> <%= movie.subcategory ? '• ' + movie.subcategory : '' %></p>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <p style="color: #aaa; grid-column: 1/-1;">No movies found in this section.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
