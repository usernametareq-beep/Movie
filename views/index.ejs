<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MovieHouse - Home</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-900 text-white min-h-screen">

  <nav class="p-4 bg-gray-800 flex justify-between items-center sticky top-0 z-50 shadow-md">
    <a href="/" class="text-2xl font-bold text-red-500">MovieHouse</a>
    <form action="/search" method="GET" class="flex gap-2">
      <input type="text" name="q" placeholder="Search movies..." required class="px-3 py-1.5 rounded bg-gray-700 text-sm focus:outline-none">
      <button type="submit" class="bg-red-600 px-4 py-1.5 rounded text-sm font-semibold hover:bg-red-700">Search</button>
    </form>
  </nav>

  <div class="p-6 max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="md:col-span-3 space-y-6">
      <!-- Category Filter Buttons -->
      <div class="flex gap-2 overflow-x-auto pb-2 border-b border-gray-800">
        <a href="/" class="px-4 py-1.5 rounded text-sm font-semibold whitespace-nowrap <%= selectedCategory === 'All' ? 'bg-red-600' : 'bg-gray-800 hover:bg-gray-700' %>">All</a>
        <% categories.forEach(cat => { %>
          <a href="/?category=<%= cat %>" class="px-4 py-1.5 rounded text-sm font-semibold whitespace-nowrap <%= selectedCategory === cat ? 'bg-red-600' : 'bg-gray-800 hover:bg-gray-700' %>"><%= cat %></a>
        <% }) %>
      </div>

      <!-- Content Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        <% movies.forEach(movie => { %>
          <a href="/movie/<%= movie._id %>" class="bg-gray-800 rounded-lg overflow-hidden block relative transform hover:scale-105 transition duration-200">
            <% if (movie.isPinned) { %>
              <span class="absolute top-2 left-2 bg-yellow-500 text-black px-2 py-0.5 text-xs font-bold rounded">Pinned</span>
            <% } %>
            <img src="<%= movie.poster || '/placeholder.jpg' %>" alt="<%= movie.title %>" class="w-full h-64 object-cover">
            <div class="p-3">
              <h3 class="font-bold text-sm truncate"><%= movie.title %></h3>
              <p class="text-xs text-gray-400 capitalize"><%= movie.category %></p>
            </div>
          </a>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div class="flex justify-center gap-2 pt-4">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="/?category=<%= selectedCategory %>&page=<%= i %>" class="px-3 py-1 rounded text-sm <%= currentPage === i ? 'bg-red-600' : 'bg-gray-800' %>"><%= i %></a>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Sidebar Popular Section -->
    <div>
      <h2 class="text-lg font-bold mb-4 border-b border-gray-700 pb-2">Most Popular</h2>
      <div class="space-y-3">
        <% popularMovies.forEach(pop => { %>
          <a href="/movie/<%= pop._id %>" class="flex gap-3 bg-gray-800 p-2 rounded hover:bg-gray-700 transition">
            <img src="<%= pop.poster || '/placeholder.jpg' %>" class="w-14 h-16 object-cover rounded">
            <div class="overflow-hidden">
              <h4 class="font-bold text-sm truncate"><%= pop.title %></h4>
              <p class="text-xs text-gray-400 mt-1">Views: <%= pop.views %></p>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </div>

</body>
</html>
