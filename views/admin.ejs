<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --border-color: #334155;
            --primary: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg-dark); color: var(--text-main); padding: 30px 15px; }
        .admin-container { max-width: 1100px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; background: var(--card-bg); padding: 15px 25px; border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 25px; }
        .header h2 { font-size: 20px; color: var(--primary); }
        .logout-btn { background: var(--danger); color: #fff; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 13px; }
        
        .grid-section { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 30px; }
        @media (max-width: 768px) { .grid-section { grid-template-columns: 1fr; } }
        
        .card { background: var(--card-bg); padding: 20px; border-radius: 8px; border: 1px solid var(--border-color); }
        .card h3 { font-size: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 15px; color: #fff; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 6px; font-size: 13px; color: var(--text-muted); }
        input[type="text"], input[type="number"], input[type="password"], select { width: 100%; padding: 10px; background: #0f172a; color: #fff; border: 1px solid var(--border-color); border-radius: 6px; font-size: 14px; }
        
        .server-input-group { display: flex; gap: 8px; margin-bottom: 8px; }
        .btn { padding: 8px 14px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 13px; }
        .btn-primary { background: var(--primary); color: #fff; }
        .btn-add { background: #3b82f6; color: #fff; margin-top: 5px; }
        .btn-remove { background: var(--danger); color: #fff; padding: 0 12px; }
        .btn-pin { background: var(--warning); color: #000; }
        .btn-unpin { background: #475569; color: #fff; }
        .btn-delete { background: var(--danger); color: #fff; }
        
        .badge { padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; white-space: nowrap !important; display: inline-block; }
        .badge-pinned { background: var(--warning); color: #000; }
        .badge-normal { background: #334155; color: #fff; }
        .badge-series { background: #8b5cf6; color: #fff; }

        .table-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .search-box { width: 250px !important; padding: 8px 12px !important; }
        
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; table-layout: fixed; }
        th, td { padding: 12px; border-bottom: 1px solid var(--border-color); vertical-align: middle; }
        th { background: #0f172a; color: var(--text-muted); font-size: 12px; }
        
        /* TITLE TEXT HIDE & ELLIPSIS FIX */
        td.movie-title {
            max-width: 250px;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }

        /* ACTIONS CELL FIXED */
        td.action-cell {
            white-space: nowrap !important;
            width: 170px;
        }
        
        .action-cell-wrapper {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .msg-box { padding: 10px; background: #064e3b; color: #6ee7b7; border-radius: 6px; margin-bottom: 15px; }
        .err-box { padding: 10px; background: #7f1d1d; color: #fca5a5; border-radius: 6px; margin-bottom: 15px; }
    </style>
</head>
<body>

    <div class="admin-container">
        <div class="header">
            <h2>⚙️ Admin Control Panel</h2>
            <a href="/admin/logout" class="logout-btn">Logout</a>
        </div>

        <% if (typeof msg !== 'undefined' && msg) { %> <div class="msg-box"><%= msg %></div> <% } %>
        <% if (typeof err !== 'undefined' && err) { %> <div class="err-box"><%= err %></div> <% } %>

        <div class="grid-section">
            <div class="card">
                <h3><%= typeof movieToEdit !== 'undefined' && movieToEdit ? '✏️ Edit Content' : '➕ Add Content' %></h3>
                <form action="/admin/save-movie" method="POST" enctype="multipart/form-data" class="scroll-form">
                    <% if (typeof movieToEdit !== 'undefined' && movieToEdit) { %>
                        <input type="hidden" name="id" value="<%= movieToEdit.id %>">
                    <% } %>

                    <div class="form-group">
                        <label>Content Type</label>
                        <select name="contentType" id="contentTypeSelect" onchange="toggleContentType()">
                            <option value="movie" <%= (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.contentType === 'movie') ? 'selected' : '' %>>Single Movie</option>
                            <option value="series" <%= (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.contentType === 'series') ? 'selected' : '' %>>Web Series</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" name="title" value="<%= (typeof movieToEdit !== 'undefined' && movieToEdit) ? movieToEdit.title : '' %>" required placeholder="Movie / Web Series Title">
                    </div>

                    <div class="form-group">
                        <label>Category</label>
                        <select name="category">
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>" <%= (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.category === cat) ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Upload Poster Image</label>
                        <input type="file" name="posterFile">
                    </div>

                    <div class="form-group">
                        <label>Poster Image URL (Optional)</label>
                        <input type="text" name="posterUrl" value="<%= (typeof movieToEdit !== 'undefined' && movieToEdit) ? movieToEdit.poster : '' %>" placeholder="https://...">
                    </div>

                    <!-- Single Movie Section -->
                    <div id="movieLinksSection" class="form-group">
                        <label>Video Links / Servers (Movie)</label>
                        <div id="videoLinksContainer">
                            <% if (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.videoLinks && movieToEdit.videoLinks.length > 0) { %>
                                <% movieToEdit.videoLinks.forEach((link, index) => { %>
                                    <div class="server-input-group">
                                        <input type="text" name="linkName[]" value="<%= link.name %>" placeholder="Server Name">
                                        <input type="text" name="linkUrl[]" value="<%= link.url %>" placeholder="Video / Embed URL">
                                        <% if (index > 0) { %><button type="button" class="btn btn-remove" onclick="removeField(this)">✕</button><% } %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="server-input-group">
                                    <input type="text" name="linkName[]" value="Server 1" placeholder="Server Name">
                                    <input type="text" name="linkUrl[]" placeholder="Video / Embed URL">
                                </div>
                            <% } %>
                        </div>
                        <button type="button" class="btn btn-add" onclick="addServerField()">+ Add Server</button>
                    </div>

                    <!-- Web Series Section -->
                    <div id="seriesEpisodesSection" class="form-group" style="display: none;">
                        <label>Episodes List (Web Series)</label>
                        <div id="episodesContainer">
                            <% if (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.episodes && movieToEdit.episodes.length > 0) { %>
                                <% movieToEdit.episodes.forEach((ep, index) => { %>
                                    <div class="server-input-group">
                                        <input type="number" name="epSeason[]" value="<%= ep.season %>" placeholder="S" style="width: 50px;">
                                        <input type="number" name="epNum[]" value="<%= ep.episodeNumber %>" placeholder="Ep" style="width: 50px;">
                                        <input type="text" name="epName[]" value="<%= ep.name %>" placeholder="Episode Title">
                                        <input type="text" name="epUrl[]" value="<%= ep.url %>" placeholder="Stream URL">
                                        <% if (index > 0) { %><button type="button" class="btn btn-remove" onclick="removeField(this)">✕</button><% } %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="server-input-group">
                                    <input type="number" name="epSeason[]" value="1" placeholder="S" style="width: 50px;">
                                    <input type="number" name="epNum[]" value="1" placeholder="Ep" style="width: 50px;">
                                    <input type="text" name="epName[]" value="Episode 1" placeholder="Episode Title">
                                    <input type="text" name="epUrl[]" placeholder="Stream URL">
                                </div>
                            <% } %>
                        </div>
                        <button type="button" class="btn btn-add" onclick="addEpisodeField()">+ Add Episode</button>
                    </div>

                    <div style="display:flex; align-items:center; gap:8px; margin:15px 0;">
                        <input type="checkbox" id="isPinned" name="isPinned" <%= (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.isPinned) ? 'checked' : '' %>>
                        <label for="isPinned" style="margin:0;">📌 Pin to top</label>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top:10px;">Save Content</button>
                </form>
            </div>

            <div>
                <div class="card" style="margin-bottom: 20px;">
                    <h3>📂 Manage Categories</h3>
                    <form action="/admin/add-category" method="POST" style="margin-bottom: 15px;" class="scroll-form">
                        <input type="text" name="categoryName" placeholder="New category name" required style="margin-bottom: 8px;">
                        <button type="submit" class="btn btn-primary" style="width:100%;">Add Category</button>
                    </form>

                    <form action="/admin/delete-category" method="POST" class="scroll-form">
                        <select name="categoryName" style="margin-bottom: 8px;">
                            <% categories.forEach(cat => { %> <option value="<%= cat %>"><%= cat %></option> <% }) %>
                        </select>
                        <button type="submit" class="btn btn-remove" style="width:100%;">Delete Category</button>
                    </form>
                </div>

                <div class="card">
                    <h3>🔒 Change Password</h3>
                    <form action="/admin/change-password" method="POST" class="scroll-form">
                        <input type="password" name="oldPassword" placeholder="Current Password" required style="margin-bottom: 8px;">
                        <input type="password" name="newPassword" placeholder="New Password" required style="margin-bottom: 8px;">
                        <button type="submit" class="btn btn-primary" style="width:100%;">Update Password</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="table-header">
                <h3>🎬 All Movies & Series List</h3>
                <input type="text" id="liveSearchInput" class="search-box" placeholder="🔍 Search..." onkeyup="filterMovies()">
            </div>
            <div style="overflow-x: auto;">
                <table id="moviesTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">Poster</th>
                            <th>Title</th>
                            <th style="width: 100px;">Type</th>
                            <th style="width: 120px;">Category</th>
                            <th style="width: 90px;">Status</th>
                            <th style="width: 170px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% movies.forEach(movie => { %>
                            <tr>
                                <td><img src="<%= movie.poster %>" width="40" height="55" style="object-fit:cover; border-radius:4px;"></td>
                                <td class="movie-title" title="<%= movie.title %>">
                                    <strong><%= movie.title %></strong>
                                </td>
                                <td>
                                    <span class="badge <%= movie.contentType === 'series' ? 'badge-series' : 'badge-normal' %>">
                                        <%= movie.contentType === 'series' ? 'Web Series' : 'Movie' %>
                                    </span>
                                </td>
                                <td style="white-space: nowrap;"><%= movie.category %></td>
                                <td>
                                    <% if (movie.isPinned) { %>
                                        <span class="badge badge-pinned">PINNED</span>
                                    <% } else { %>
                                        <span class="badge badge-normal">Normal</span>
                                    <% } %>
                                </td>
                                <td class="action-cell">
                                    <div class="action-cell-wrapper">
                                        <form action="/admin/toggle-pin/<%= movie.id %>" method="POST" style="display:inline;" class="scroll-form">
                                            <button type="submit" class="btn <%= movie.isPinned ? 'btn-unpin' : 'btn-pin' %>" style="padding:4px 8px; font-size:11px;">
                                                <%= movie.isPinned ? 'Unpin' : 'Pin' %>
                                            </button>
                                        </form>
                                        <a href="/admin?edit=<%= movie.id %>" class="btn btn-add" style="padding:4px 8px; font-size:11px; text-decoration:none;">Edit</a>
                                        <form action="/admin/delete-movie/<%= movie.id %>" method="POST" style="display:inline;" class="scroll-form" onsubmit="return confirm('Delete this?')">
                                            <button type="submit" class="btn btn-delete" style="padding:4px 8px; font-size:11px;">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function toggleContentType() {
            const type = document.getElementById('contentTypeSelect').value;
            const movieSection = document.getElementById('movieLinksSection');
            const seriesSection = document.getElementById('seriesEpisodesSection');

            if (type === 'series') {
                movieSection.style.display = 'none';
                seriesSection.style.display = 'block';
            } else {
                movieSection.style.display = 'block';
                seriesSection.style.display = 'none';
            }
        }

        function addServerField() {
            const container = document.getElementById('videoLinksContainer');
            const count = container.querySelectorAll('.server-input-group').length + 1;
            const div = document.createElement('div');
            div.className = 'server-input-group';
            div.innerHTML = `
                <input type="text" name="linkName[]" value="Server ${count}" placeholder="Server Name">
                <input type="text" name="linkUrl[]" placeholder="Video / Embed URL">
                <button type="button" class="btn btn-remove" onclick="removeField(this)">✕</button>
            `;
            container.appendChild(div);
        }

        function addEpisodeField() {
            const container = document.getElementById('episodesContainer');
            const count = container.querySelectorAll('.server-input-group').length + 1;
            const div = document.createElement('div');
            div.className = 'server-input-group';
            div.innerHTML = `
                <input type="number" name="epSeason[]" value="1" placeholder="S" style="width: 50px;">
                <input type="number" name="epNum[]" value="${count}" placeholder="Ep" style="width: 50px;">
                <input type="text" name="epName[]" value="Episode ${count}" placeholder="Episode Title">
                <input type="text" name="epUrl[]" placeholder="Stream URL">
                <button type="button" class="btn btn-remove" onclick="removeField(this)">✕</button>
            `;
            container.appendChild(div);
        }

        function removeField(btn) { 
            btn.parentElement.remove(); 
        }

        function filterMovies() {
            const filter = document.getElementById('liveSearchInput').value.toLowerCase();
            const tr = document.getElementById('moviesTable').getElementsByTagName('tr');
            for (let i = 1; i < tr.length; i++) {
                const titleCell = tr[i].getElementsByClassName('movie-title')[0];
                if (titleCell) {
                    tr[i].style.display = (titleCell.textContent.toLowerCase().indexOf(filter) > -1) ? "" : "none";
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleContentType();
            
            const scrollPos = localStorage.getItem("adminScrollPos");
            if (scrollPos) { 
                window.scrollTo(0, parseInt(scrollPos)); 
                localStorage.removeItem("adminScrollPos"); 
            }
            
            document.querySelectorAll(".scroll-form").forEach(form => {
                form.addEventListener("submit", () => localStorage.setItem("adminScrollPos", window.scrollY));
            });
        });
    </script>
</body>
</html>
