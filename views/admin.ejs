<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-900 text-white p-6">
  <div class="max-w-5xl mx-auto space-y-6">
    <h1 class="text-3xl font-bold border-b border-gray-700 pb-2">Admin Dashboard</h1>

    <form action="/admin/save" method="POST" enctype="multipart/form-data" class="bg-gray-800 p-4 rounded space-y-4">
      <% if (movieToEdit) { %><input type="hidden" name="id" value="<%= movieToEdit._id %>"><% } %>
      <div class="grid grid-cols-2 gap-4">
        <input type="text" name="title" value="<%= movieToEdit ? movieToEdit.title : '' %>" placeholder="Title" required class="p-2 bg-gray-700 rounded">
        <select name="contentType" class="p-2 bg-gray-700 rounded">
          <option value="movie" <%= movieToEdit && movieToEdit.contentType==='movie'?'selected':'' %>>Movie</option>
          <option value="series" <%= movieToEdit && movieToEdit.contentType==='series'?'selected':'' %>>Series</option>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <select name="category" class="p-2 bg-gray-700 rounded">
          <% categories.forEach(c => { %>
            <option value="<%= c %>" <%= movieToEdit && movieToEdit.category===c?'selected':'' %>><%= c %></option>
          <% }) %>
        </select>
        <input type="text" name="posterUrl" value="<%= movieToEdit ? movieToEdit.poster : '' %>" placeholder="Poster URL" class="p-2 bg-gray-700 rounded">
      </div>

      <div>
        <label><input type="checkbox" name="isPinned" <%= movieToEdit && movieToEdit.isPinned?'checked':'' %>> Pin to top</label>
      </div>

      <div class="flex gap-2">
        <input type="text" name="linkName" placeholder="Server Name" class="p-2 bg-gray-700 rounded w-1/3">
        <input type="text" name="linkUrl" placeholder="Video Link" class="p-2 bg-gray-700 rounded w-2/3">
      </div>

      <button type="submit" class="bg-blue-600 px-4 py-2 rounded">Save</button>
    </form>

    <div class="bg-gray-800 p-4 rounded">
      <h2 class="font-bold mb-2">Add Category</h2>
      <form action="/admin/add-category" method="POST" class="flex gap-2">
        <input type="text" name="categoryName" placeholder="Category Name" required class="p-2 bg-gray-700 rounded">
        <button type="submit" class="bg-green-600 px-4 py-2 rounded">Add</button>
      </form>
    </div>

    <div class="bg-gray-800 p-4 rounded">
      <h2 class="font-bold mb-2">All Movies</h2>
      <% movies.forEach(m => { %>
        <div class="flex justify-between items-center border-b border-gray-700 py-2">
          <span><%= m.title %> (<%= m.category %>)</span>
          <div class="flex gap-2">
            <form action="/admin/toggle-pin/<%= m._id %>" method="POST"><button class="<%= m.isPinned?'text-yellow-400':'text-gray-500' %>">★</button></form>
            <a href="/admin?edit=<%= m._id %>" class="bg-yellow-600 px-2 py-1 rounded text-sm">Edit</a>
            <form action="/admin/delete/<%= m._id %>" method="POST"><button class="bg-red-600 px-2 py-1 rounded text-sm">Delete</button></form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
