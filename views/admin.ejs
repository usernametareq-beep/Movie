<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --border-color: #334155;
            --primary: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: var(--bg-dark); 
            color: var(--text-main); 
            padding: 30px 15px; 
        }

        .admin-container { max-width: 1100px; margin: 0 auto; }
        
        .header { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            background: var(--card-bg); 
            padding: 15px 25px; 
            border-radius: 8px; 
            border: 1px solid var(--border-color); 
            margin-bottom: 25px; 
        }

        .header h2 { font-size: 20px; color: var(--primary); }
        .logout-btn { 
            background: var(--danger); 
            color: #fff; 
            padding: 8px 16px; 
            border-radius: 6px; 
            text-decoration: none; 
            font-weight: bold; 
            font-size: 13px;
        }

        .grid-section { 
            display: grid; 
            grid-template-columns: 2fr 1fr; 
            gap: 20px; 
            margin-bottom: 30px; 
        }
        @media (max-width: 768px) { .grid-section { grid-template-columns: 1fr; } }

        .card { 
            background: var(--card-bg); 
            padding: 20px; 
            border-radius: 8px; 
            border: 1px solid var(--border-color); 
        }

        .card h3 { 
            font-size: 16px; 
            border-bottom: 1px solid var(--border-color); 
            padding-bottom: 10px; 
            margin-bottom: 15px; 
            color: #fff;
        }

        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 6px; font-size: 13px; color: var(--text-muted); }
        input[type="text"], input[type="password"], select, textarea { 
            width: 100%; 
            padding: 10px; 
            background: #0f172a; 
            color: #fff; 
            border: 1px solid var(--border-color); 
            border-radius: 6px; 
            font-size: 14px; 
        }
        input:focus, select:focus { outline: none; border-color: var(--primary); }

        .server-input-group { display: flex; gap: 8px; margin-bottom: 8px; }
        .server-input-group input { margin-bottom: 0; }

        .btn { 
            padding: 10px 18px; 
            border: none; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: bold; 
            font-size: 13px; 
            transition: 0.2s; 
        }
        .btn-primary { background: var(--primary); color: #fff; }
        .btn-add { background: #3b82f6; color: #fff; margin-top: 5px; }
        .btn-remove { background: var(--danger); color: #fff; padding: 0 12px; }
        .btn-pin { background: var(--warning); color: #000; }
        .btn-unpin { background: #475569; color: #fff; }
        .btn-delete { background: var(--danger); color: #fff; }

        .checkbox-container { display: flex; align-items: center; gap: 8px; margin: 15px 0; }
        .checkbox-container input { width: auto; cursor: pointer; }

        /* Table Design */
        .table-responsive { overflow-x: auto; margin-top: 15px; }
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
        th, td { padding: 12px; border-bottom: 1px solid var(--border-color); vertical-align: middle; }
        th { background: #0f172a; color: var(--text-muted); font-size: 12px; text-transform: uppercase; }
        tr:hover { background: rgba(255,255,255,0.02); }

        .badge { padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; }
        .badge-pinned { background: var(--warning); color: #000; }
        .badge-normal { background: #334155; color: #fff; }

        .msg-box { padding: 10px; background: #064e3b; color: #6ee7b7; border-radius: 6px; margin-bottom: 15px; font-size: 13px; }
        .err-box { padding: 10px; background: #7f1d1d; color: #fca5a5; border-radius: 6px; margin-bottom: 15px; font-size: 13px; }
    </style>
</head>
<body>

    <div class="admin-container">
        <div class="header">
            <h2>⚙️ Admin Control Panel</h2>
            <a href="/admin/logout" class="logout-btn">Logout</a>
        </div>

        <% if (typeof msg !== 'undefined' && msg) { %>
            <div class="msg-box"><%= msg %></div>
        <% } %>
        <% if (typeof err !== 'undefined' && err) { %>
            <div class="err-box"><%= err %></div>
        <% } %>

        <div class="grid-section">
            <div class="card">
                <h3><%= typeof movieToEdit !== 'undefined' && movieToEdit ? '✏️ Edit Movie' : '➕ Add New Movie' %></h3>
                <form action="/admin/save-movie" method="POST" enctype="multipart/form-data">
                    <% if (typeof movieToEdit !== 'undefined' && movieToEdit) { %>
                        <input type="hidden" name="id" value="<%= movieToEdit.id %>">
                    <% } %>

                    <div class="form-group">
                        <label>Movie Title</label>
                        <input type="text" name="title" value="<%= (typeof movieToEdit !== 'undefined' && movieToEdit) ? movieToEdit.title : '' %>" required placeholder="Enter movie title">
                    </div>

                    <div class="form-group">
                        <label>Category</label>
                        <select name="category">
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>" <%= (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.category === cat) ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Upload Poster Image</label>
                        <input type="file" name="posterFile">
                    </div>

                    <div class="form-group">
                        <label>Poster Image URL (Optional)</label>
                        <input type="text" name="posterUrl" value="<%= (typeof movieToEdit !== 'undefined' && movieToEdit) ? movieToEdit.poster : '' %>" placeholder="https://...">
                    </div>

                    <div class="form-group">
                        <label>Video Links / Servers</label>
                        <div id="videoLinksContainer">
                            <% if (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.videoLinks && movieToEdit.videoLinks.length > 0) { %>
                                <% movieToEdit.videoLinks.forEach((link, index) => { %>
                                    <div class="server-input-group">
                                        <input type="text" name="linkName[]" value="<%= link.name %>" placeholder="Server Name">
                                        <input type="text" name="linkUrl[]" value="<%= link.url %>" placeholder="Video / Embed URL" required>
                                        <% if (index > 0) { %>
                                            <button type="button" class="btn btn-remove" onclick="removeServer(this)">✕</button>
                                        <% } %>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="server-input-group">
                                    <input type="text" name="linkName[]" value="Server 1" placeholder="Server Name">
                                    <input type="text" name="linkUrl[]" placeholder="Video / Embed URL" required>
                                </div>
                            <% } %>
                        </div>
                        <button type="button" class="btn btn-add" onclick="addServerField()">+ Add More Server</button>
                    </div>

                    <div class="checkbox-container">
                        <input type="checkbox" id="isPinned" name="isPinned" <%= (typeof movieToEdit !== 'undefined' && movieToEdit && movieToEdit.isPinned) ? 'checked' : '' %>>
                        <label for="isPinned" style="margin-bottom:0; cursor:pointer;">📌 Pin this movie to top</label>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top:10px;">
                        <%= (typeof movieToEdit !== 'undefined' && movieToEdit) ? 'Update Movie' : 'Save Movie' %>
                    </button>
                </form>
            </div>

            <div>
                <div class="card" style="margin-bottom: 20px;">
                    <h3>📂 Manage Categories</h3>
                    <form action="/admin/add-category" method="POST" style="margin-bottom: 15px;">
                        <div class="form-group">
                            <input type="text" name="categoryName" placeholder="New category name" required>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width:100%;">Add Category</button>
                    </form>

                    <form action="/admin/delete-category" method="POST">
                        <div class="form-group">
                            <select name="categoryName">
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat %>"><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-remove" style="width:100%;">Delete Category</button>
                    </form>
                </div>

                <div class="card">
                    <h3>🔒 Change Password</h3>
                    <form action="/admin/change-password" method="POST">
                        <div class="form-group">
                            <input type="password" name="oldPassword" placeholder="Current Password" required>
                        </div>
                        <div class="form-group">
                            <input type="password" name="newPassword" placeholder="New Password" required>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width:100%;">Update Password</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card">
            <h3>🎬 All Movies List</h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Poster</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% movies.forEach(movie => { %>
                            <tr>
                                <td><img src="<%= movie.poster %>" width="40" height="55" style="object-fit:cover; border-radius:4px;"></td>
                                <td><strong><%= movie.title %></strong></td>
                                <td><%= movie.category %></td>
                                <td>
                                    <% if (movie.isPinned) { %>
                                        <span class="badge badge-pinned">PINNED</span>
                                    <% } else { %>
                                        <span class="badge badge-normal">Normal</span>
                                    <% } %>
                                </td>
                                <td>
                                    <form action="/admin/toggle-pin/<%= movie.id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn <%= movie.isPinned ? 'btn-unpin' : 'btn-pin' %>" style="padding:4px 8px; font-size:11px;">
                                            <%= movie.isPinned ? 'Unpin' : 'Pin' %>
                                        </button>
                                    </form>
                                    <a href="/admin?edit=<%= movie.id %>" class="btn btn-add" style="padding:4px 8px; font-size:11px; text-decoration:none;">Edit</a>
                                    <form action="/admin/delete-movie/<%= movie.id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-delete" style="padding:4px 8px; font-size:11px;">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function addServerField() {
            const container = document.getElementById('videoLinksContainer');
            const count = container.querySelectorAll('.server-input-group').length + 1;
            
            const div = document.createElement('div');
            div.className = 'server-input-group';
            div.innerHTML = `
                <input type="text" name="linkName[]" value="Server ${count}" placeholder="Server Name">
                <input type="text" name="linkUrl[]" placeholder="Video / Embed URL" required>
                <button type="button" class="btn btn-remove" onclick="removeServer(this)">✕</button>
            `;
            container.appendChild(div);
        }

        function removeServer(button) {
            button.parentElement.remove();
        }
    </script>
</body>
</html>
