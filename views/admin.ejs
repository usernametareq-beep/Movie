<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Movie House</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #fff;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .card {
            background: #1f1f1f;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        input[type="text"], select, textarea {
            width: 100%;
            padding: 10px;
            border-radius: 4px;
            border: 1px solid #444;
            background: #2b2b2b;
            color: #fff;
            box-sizing: border-box;
        }
        .btn {
            background-color: #e50914;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn:hover {
            background-color: #b80710;
        }
        .btn-success {
            background-color: #28a745;
        }
        .btn-success:hover {
            background-color: #218838;
        }
        .alert {
            padding: 10px;
            background: #28a745;
            color: white;
            border-radius: 4px;
            margin-bottom: 15px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #333;
        }
        th {
            background-color: #2b2b2b;
        }
        .action-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 14px;
            padding: 0;
            margin: 0 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Admin Panel</h2>
            <a href="/" style="color: #aaa; text-decoration: none;">← Visit Site</a>
        </div>

        <% if (typeof msg !== 'undefined' && msg) { %>
            <div class="alert"><%= msg %></div>
        <% } %>

        <!-- Add / Edit Movie Form -->
        <div class="card">
            <h3><%= movieToEdit ? 'Edit Movie' : 'Add New Movie' %></h3>
            <form action="/admin/save-movie" method="POST" enctype="multipart/form-data" class="action-form">
                <% if (movieToEdit) { %>
                    <input type="hidden" name="id" value="<%= movieToEdit._id %>">
                <% } %>

                <div class="form-group">
                    <label>Movie Title:</label>
                    <input type="text" name="title" value="<%= movieToEdit ? movieToEdit.title : '' %>" required>
                </div>

                <div style="display: flex; gap: 15px;">
                    <div class="form-group" style="flex: 1;">
                        <label>Category:</label>
                        <select name="category" id="mainCatSelect" onchange="updateSubcatOptions()" required>
                            <option value="">Select Category</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>" <%= (movieToEdit && movieToEdit.category === cat) ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group" style="flex: 1;">
                        <label>Subcategory:</label>
                        <select name="subcategory" id="subCatSelect">
                            <option value="">Select Subcategory (Optional)</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Poster Image URL:</label>
                    <input type="text" name="posterUrl" value="<%= movieToEdit ? movieToEdit.poster : '' %>" placeholder="https://image-link.com/poster.jpg">
                </div>

                <div class="form-group">
                    <label>Video / Stream Link (MP4, YouTube, Streamtape, etc.):</label>
                    <input type="text" name="linkUrl" value="<%= (movieToEdit && movieToEdit.videoLinks && movieToEdit.videoLinks.length > 0) ? movieToEdit.videoLinks[0].url : '' %>" required placeholder="https://...">
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" name="isPinned" <%= (movieToEdit && movieToEdit.isPinned) ? 'checked' : '' %>> Pin to Home Page
                    </label>
                </div>

                <button type="submit" class="btn"><%= movieToEdit ? 'Update Movie' : 'Upload Movie' %></button>
                <% if (movieToEdit) { %>
                    <a href="/admin" style="color: #aaa; margin-left: 10px;">Cancel Edit</a>
                <% } %>
            </form>
        </div>

        <!-- Manage Subcategories -->
        <div class="card">
            <h3>Manage Subcategories</h3>
            <form action="/admin/add-subcategory" method="POST" class="action-form" style="display: flex; gap: 10px; margin-bottom: 15px;">
                <select name="parentCategory" required style="flex: 1;">
                    <option value="">Select Parent Category</option>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat %>"><%= cat %></option>
                    <% }) %>
                </select>
                <input type="text" name="subcategoryName" placeholder="Subcategory Name" required style="flex: 1;">
                <button type="submit" class="btn btn-success">Add Subcategory</button>
            </form>

            <h4>Existing Subcategories:</h4>
            <ul>
                <% if (typeof subcategories !== 'undefined' && subcategories.length > 0) { %>
                    <% subcategories.forEach(sub => { %>
                        <li style="margin-bottom: 8px;">
                            <strong><%= sub.parentCategory %></strong> ➔ <%= sub.name %>
                            <form action="/admin/delete-subcategory" method="POST" class="action-form" style="display: inline; margin-left: 10px;">
                                <input type="hidden" name="subcategoryId" value="<%= sub._id %>">
                                <button type="submit" class="action-btn" style="color: #ff4d4d;">Delete</button>
                            </form>
                        </li>
                    <% }) %>
                <% } else { %>
                    <p style="color: #aaa;">No subcategories added yet.</p>
                <% } %>
            </ul>
        </div>

        <!-- All Movies List with Live Search -->
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-bottom: 15px;">
                <h3 style="margin: 0;">All Movies List</h3>
                <input 
                    type="text" 
                    id="adminMovieSearch" 
                    onkeyup="filterAdminMovies()" 
                    placeholder="🔍 Search movies by title or category..." 
                    style="width: 280px;"
                >
            </div>

            <table id="movieTable">
                <thead>
                    <tr>
                        <th>Poster</th>
                        <th>Title</th>
                        <th>Category / Subcategory</th>
                        <th>Views</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (movies && movies.length > 0) { %>
                        <% movies.forEach(movie => { %>
                            <tr class="movie-row">
                                <td style="text-align: center;">
                                    <img src="<%= movie.poster %>" width="45" height="60" style="object-fit: cover; border-radius: 4px;">
                                </td>
                                <td class="movie-title">
                                    <strong><%= movie.title %></strong>
                                    <% if (movie.isPinned) { %> <span style="color: gold;">📌 Pinned</span> <% } %>
                                </td>
                                <td class="movie-category">
                                    <%= movie.category %> 
                                    <% if (movie.subcategory) { %> <small style="color: #aaa;">(<%= movie.subcategory %>)</small> <% } %>
                                </td>
                                <td><%= movie.views || 0 %></td>
                                <td>
                                    <a href="/admin?edit=<%= movie._id %>" style="color: #4da6ff; margin-right: 8px; text-decoration: none;">Edit</a>
                                    
                                    <form action="/admin/toggle-pin/<%= movie._id %>" method="POST" class="action-form" style="display: inline;">
                                        <button type="submit" class="action-btn" style="color: gold;">
                                            <%= movie.isPinned ? 'Unpin' : 'Pin' %>
                                        </button>
                                    </form>
                                    | 
                                    <form action="/admin/delete-movie/<%= movie._id %>" method="POST" class="action-form" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this movie?');">
                                        <button type="submit" class="action-btn" style="color: #ff4d4d;">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; color: #aaa;">No movies found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // 🟢 ১. সাব-ক্যাটাগরি ডাইনামিক ড্রপডাউন ফিল্টার
        const allSubcategories = <%- JSON.stringify(subcategories || []) %>;
        const selectedSub = "<%= movieToEdit ? movieToEdit.subcategory : '' %>";

        function updateSubcatOptions() {
            const mainCat = document.getElementById('mainCatSelect').value;
            const subSelect = document.getElementById('subCatSelect');
            
            subSelect.innerHTML = '<option value="">Select Subcategory (Optional)</option>';

            const filteredSubs = allSubcategories.filter(sub => sub.parentCategory === mainCat);
            
            filteredSubs.forEach(sub => {
                const option = document.createElement('option');
                option.value = sub.name;
                option.textContent = sub.name;
                if (sub.name === selectedSub) {
                    option.selected = true;
                }
                subSelect.appendChild(option);
            });
        }

        // 🟢 ২. টেবিলের ভেতর লাইভ সার্চ লজিক
        function filterAdminMovies() {
            const filter = document.getElementById('adminMovieSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#movieTable tbody .movie-row');

            rows.forEach(row => {
                const titleText = row.querySelector('.movie-title').textContent.toLowerCase();
                const categoryText = row.querySelector('.movie-category').textContent.toLowerCase();

                if (titleText.includes(filter) || categoryText.includes(filter)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // 🟢 ৩. স্ক্রোল পজিশন ধরে রাখার স্মার্ট মেমোরি
        document.addEventListener("DOMContentLoaded", function () {
            updateSubcatOptions();

            const scrollPosition = localStorage.getItem("adminScrollPosition");
            if (scrollPosition) {
                window.scrollTo(0, parseInt(scrollPosition, 10));
                localStorage.removeItem("adminScrollPosition");
            }

            const actionForms = document.querySelectorAll(".action-form");
            actionForms.forEach(form => {
                form.addEventListener("submit", function () {
                    localStorage.setItem("adminScrollPosition", window.scrollY);
                });
            });
        });
    </script>
</body>
</html>
