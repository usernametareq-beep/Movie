<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        /* আপনার বিদ্যমান UI স্টাইলসমূহ (যা অপরিবর্তিত রাখা হয়েছে) */
        body {
            background-color: #0d111a;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        tr {
            border-bottom: 1px solid #141a26;
        }

        td {
            padding: 12px 15px;
            vertical-align: middle;
        }

        /* ব্যাজের বিদ্যমান ডিজাইন (শুধুমাত্র এক লাইনে থাকার ফিক্স যোগ করা হয়েছে) */
        .type-badge {
            background-color: #6b21a8;
            color: #ffffff;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            
            /* UI ফিক্স: যাতে 'Web Series' ভেঙে নিচে না যায় */
            white-space: nowrap !important;
            display: inline-block;
        }

        .status-badge {
            background-color: #1f2738;
            color: #8b9bb4;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap !important;
            display: inline-block;
        }

        .status-badge.pinned {
            background-color: #ff9800;
            color: #ffffff;
        }

        /* বাটন গ্রুপের UI ফিক্স: Pin, Edit, Delete এক লাইনে আনার জন্য */
        .action-cell {
            display: flex !important;
            align-items: center;
            justify-content: flex-start;
            gap: 6px;
            white-space: nowrap !important;
        }

        /* সাধারণ বাটন স্টাইল */
        .btn {
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 !important;
        }

        .btn-pin { background-color: #ff9800; color: #fff; }
        .btn-unpin { background-color: #4b5563; color: #fff; }
        .btn-edit { background-color: #3b82f6; color: #fff; }
        .btn-delete { background-color: #ef4444; color: #fff; }
    </style>
</head>
<body>

    <table>
        <tbody>
            <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
                <% movies.forEach(movie => { %>
                    <tr>
                        <!-- 1. Content Type Badge -->
                        <td>
                            <span class="type-badge">
                                <%= (movie.type || movie.category || 'Movie').toLowerCase().includes('series') ? 'Web Series' : 'Movie' %>
                            </span>
                        </td>

                        <!-- 2. Category Title -->
                        <td><%= movie.category || 'Bangladeshi' %></td>

                        <!-- 3. Status Badge -->
                        <td>
                            <span class="status-badge <%= movie.isPinned ? 'pinned' : '' %>">
                                <%= movie.isPinned ? 'PINNED' : 'Normal' %>
                            </span>
                        </td>

                        <!-- 4. Action Buttons (Fix Applied to Stay in One Line) -->
                        <td class="action-cell">
                            <% if (movie.isPinned) { %>
                                <a href="/admin/unpin/<%= movie._id %>" class="btn btn-unpin">Unpin</a>
                            <% } else { %>
                                <a href="/admin/pin/<%= movie._id %>" class="btn btn-pin">Pin</a>
                            <% } %>

                            <a href="/admin/edit/<%= movie._id %>" class="btn btn-edit">Edit</a>
                            
                            <a href="/admin/delete/<%= movie._id %>" class="btn btn-delete" onclick="return confirm('Are you sure you want to delete this?')">Delete</a>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" style="text-align: center; color: #8b9bb4;">No items available.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

</body>
</html>
